# Supabase Project URL (find in Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon/Public Key (find in Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key — KEEP SECRET, never expose to client
# (find in Settings → API → Service role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
